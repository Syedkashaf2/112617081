#include <iostream>
#include <string>
#include <vector>
using namespace std;

bool isPallindrome()
{
    string s{};
    cout << "ENTER THE STRING YOU WANT TO CHECK : ";
    cin >> s;

    for ( int i{}; i < s.length() - 1; i++)
    {
        if ( s[i] != s[(s.length() -1) - i] )
        {
            return false;
        } else 
        {
            return true;
        }
    }
}

int main()
{
    if(isPallindrome)
    
        cout << "Pallindrome\n";
    else 
        cout << "Not-Pallindrome\n";
	return 0;
}
